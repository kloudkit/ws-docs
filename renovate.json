{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting"
  ],
  "assignees": [ "kloud-bit" ],
  "labels": [ "type: dependency 🔼" ],
  "schedule": [ "every weekend" ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🤖 Renovate Dashboard",
  "commitMessageAction": "🔼 Bump",
  "regexManagers": [
    {
      "fileMatch": [
        "^\\.vitepress\\/.*\\.(?:vue|ts|mts)$",
        "^docs\\/.*\\.md$",
        "^README\\.md$"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io\\/kloudkit\\/workspace):(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "fileMatch": [ "^README\\.md$" ],
      "matchStrings": [
        "v(?<currentValue>\\d+\\.\\d+\\.\\d+)-dockertag"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/kloudkit/workspace",
      "versioningTemplate": "semver"
    },
    {
      "fileMatch": [ "^docs\\/.*\\.md$" ],
      "matchStrings": [
        "(?<depName>ghcr\\.io\\/kloudkit\\/ws-feature-store):(?<currentValue>v\\d{4}\\.\\d{2}(?:\\.\\d{2})?)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d{4})\\.(?<minor>\\d{2})(?:\\.(?<patch>\\d{2}))?$"
    }
  ]
}
